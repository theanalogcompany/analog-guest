# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Voyage AI
VOYAGE_API_KEY=

#Sendblue
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_SIGNING_SECRET=

#Slack
SLACK_ALERTS_WEBHOOK_URL=

#PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

#Google Drive
GOOGLE_DRIVE_VENUES_FOLDER_ID=

#Airtable
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_ID=

#Cron
CRON_SECRET=

#Admin (THE-198) — base URL the magic-link callback returns to.
# Local dev: http://localhost:3000
# Production: https://admin.theanalog.company
# Vercel previews can leave this unset — the form falls back to NEXT_PUBLIC_VERCEL_URL.
NEXT_PUBLIC_ADMIN_URL=

# Langfuse Cloud project keys (THE-200). Leave blank locally to no-op;
# set in Vercel env per environment to light up tracing in prod/preview.
# LANGFUSE_BASE_URL is the canonical name for the host; LANGFUSE_HOST is
# also accepted as a legacy alias (slated for removal post-pilot).
# Host must be one of:
#   https://us.cloud.langfuse.com  (US)
#   https://cloud.langfuse.com     (EU)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# THE-216: capture full content (inbound/outbound bodies, retrieved corpus
# chunks, system + user prompts, per-attempt generations) on each agent run's
# trace. Default true (capture on) when unset. Set to "false" to ship
# metadata-only traces — same shape as THE-200's original implementation.
# Pilot venues run with this on so we can debug voice-quality issues from a
# single trace; flip to false if a venue's privacy posture demands it.
LANGFUSE_CAPTURE_CONTENT=

# Apple Push Notifications (TAC-207). Required for the operator-app push
# pipeline. Set on BOTH Production AND Preview Vercel environments —
# missing vars fail SILENTLY (push doesn't arrive; no 500). See CLAUDE.md
# §"Common gotchas" → "APNs env vars fail SILENTLY" for the diagnostic chain.
# APNS_AUTH_KEY is the full .p8 PEM contents (multi-line). APNS_ENV selects
# the host: 'production' → api.push.apple.com; 'sandbox' → api.sandbox.push.apple.com.
APNS_AUTH_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_ENV=

# Diagnostics — capture raw Sendblue webhook bodies for schema-drift
# investigation. LEAKS PII (guest phone numbers, message content) into Vercel
# logs. Default OFF; only set to "true" during a deliberate, time-bounded
# capture window and unset it immediately after. When on, logs every Sendblue
# webhook (inbound + status), and fires before signature verification so it
# also captures malformed / unsigned payloads — that's intentional for drift
# investigation; just don't leave it on. Name says INBOUND because the primary
# drift surface is the inbound payload; the log itself is broader. The
# unknown-key keys-only warning fires regardless of this flag.
SENDBLUE_LOG_RAW_INBOUND=

# Square POS integration. Set on BOTH Production AND Preview Vercel envs.
# SQUARE_ENV: sandbox | production (also selects which access token is used).
# POS_TOKEN_ENC_KEY: 32-byte base64 — generate with `openssl rand -base64 32`.
SQUARE_ENV=sandbox
SQUARE_SANDBOX_ACCESS_TOKEN=
SQUARE_PRODUCTION_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=
SQUARE_APPLICATION_ID=
SQUARE_OAUTH_SECRET=
SQUARE_OAUTH_REDIRECT_URL=
POS_TOKEN_ENC_KEY=

# Instagram DM channel (TAC-445). Meta app 1227804829539686, Instagram Login
# path — NOT Facebook Login, so the API host is graph.instagram.com and the
# token is an Instagram User access token, never a Page token. Set on BOTH
# Production AND Preview Vercel envs.
#
# META_VERIFY_TOKEN is the shared string Meta echoes back during the callback
# URL handshake (GET /api/webhooks/instagram). Any value you choose, but it
# must match what you type into the Meta App Dashboard character for
# character. Until it is set the handshake returns 403 and the dashboard
# refuses to save the URL, which is the thing that blocks all further setup.
#
# INSTAGRAM_APP_SECRET keys the HMAC-SHA256 digest over the raw request body
# that arrives in x-hub-signature-256, and it is ENFORCED (TAC-458): a delivery
# that does not verify gets 403. Unset or empty, EVERY delivery gets 403,
# genuine ones included, and Meta disables the subscription after enough of
# those. Nothing alerts on that; the route logs
# instagram_signature_misconfigured at error level, and that is the only
# trace. Rotating the secret in the Meta dashboard without updating it in
# Vercel has the same effect and logs only ordinary signature rejections.
#
# INSTAGRAM_APP_ID has NO READER anywhere in this repo as of TAC-445. It is
# set for the later Graph API work; the webhook route never consults it. Said
# plainly so nobody infers behavior from its presence.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_VERIFY_TOKEN=

# INSTAGRAM_ACCESS_TOKEN (TAC-479) is the Instagram User access token the
# guest profile refresh uses (lib/messaging/instagram/refresh-profile.ts, its
# only reader). It must belong to the Instagram account whose ID is in
# venues.instagram_account_id, or every refresh for that venue's guests logs
# instagram_profile_wrong_account. Long-lived tokens expire about every 60
# days (TAC-460); an expired one logs instagram_profile_token_rejected, and
# an unset one instagram_profile_token_missing.
INSTAGRAM_ACCESS_TOKEN=
