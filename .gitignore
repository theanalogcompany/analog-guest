# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Google OAuth client secret (Drive ADC) — never committed, per CLAUDE.md
# "Drive integration → ADC token refresh"
client_secret_*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed). Templates ending in
# .example are tracked so README's "copy .env.local.example to .env.local"
# instruction works out of the box.
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local scratch dir for one-off experiments — not committed; pre-commit
# tsc would otherwise scan WIP files that haven't been wired to deps yet.
/scripts/sandbox

# TAC knowledge-load: venue knowledge proposals and dedup reports. Both hold
# owner-document content (farm detail, named staff, founder history) for a
# real venue and this repo is public, so neither is committed.
/scripts/data
/scripts/output
.worktrees/
.claude/scheduled_tasks.lock
supabase/.temp/

# Measurement run logs (scripts/measurement). createRunLog writes them to
# measurement-runs/ by default; the bare *.jsonl line covers the ones earlier
# runs dropped at the repo root, and any a caller points elsewhere. They are
# evidence for a ticket, not source: quote the findings and the filename on the
# ticket rather than committing the file.
measurement-runs/
*.jsonl
